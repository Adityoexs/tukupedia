# ===========================================
# Tukupedia Environment Variables
# ===========================================

# Database Configuration
DATABASE_URL=postgresql://tukupedia:tukupedia@localhost:5432/tukupedia
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=tukupedia
DATABASE_PASSWORD=tukupedia
DATABASE_NAME=tukupedia

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_URL=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5000/graphql
NEXT_PUBLIC_APP_NAME=Tukupedia
NEXT_PUBLIC_APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production

# OAuth (Optional - for production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email Configuration (Mock for MVP)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@tukupedia.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Payment Gateway (Mock for MVP)
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
XENDIT_API_KEY=

# Storage Configuration (S3/MinIO)
STORAGE_PROVIDER=minio
S3_BUCKET=tukupedia-products
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000

# Search Configuration
SEARCH_ENGINE=sqlite_fts
# ELASTICSEARCH_URL=http://localhost:9200

# Logging
LOG_LEVEL=Information
SERILOG_MIN_LEVEL=Debug

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Feature Flags
FEATURE_PWA_ENABLED=true
FEATURE_PUSH_NOTIFICATIONS_ENABLED=true
FEATURE_BACKGROUND_SYNC_ENABLED=true
FEATURE_ADVANCED_SEARCH_ENABLED=true

# Deployment Configuration
NODE_ENV=development
ENVIRONMENT=development

# Optional: Monitoring & Analytics (Future)
SENTRY_DSN=
DATADOG_API_KEY=
